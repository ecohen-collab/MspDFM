*.tmp
_*_tmp.json

# Bureautique & mails (lourds, non utilisés en runtime — et souvent VERROUILLÉS par Word /
# OneDrive, ce qui fait échouer `az acr build` sur un « Permission denied » au moment de
# fabriquer le tar du contexte).
*.xlsm
*.xlsx
*.xls
*.docx
*.doc
*.eml
*.msg
vba_export.txt
*.csv

